# Frontend (Vite) — bezpečné veřejné hodnoty
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxx

# Supabase Edge Functions (server-only) se nastavují přes Supabase CLI, ne přes .env:
#   supabase secrets set OPENAI_API_KEY=xxxxx
# SUPABASE_URL a SUPABASE_SERVICE_ROLE_KEY jsou v Edge Functions dostupné automaticky.
